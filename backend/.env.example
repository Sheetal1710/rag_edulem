# NVIDIA API keys from build.nvidia.com
# Set NVIDIA_API_KEY alone to use one key for both; the per-service keys override it.
NVIDIA_API_KEY="nvapi-your-key-here"
# NVIDIA_LLM_API_KEY="nvapi-llm-key"
# NVIDIA_EMBED_API_KEY="nvapi-embed-key"

# Models
NVIDIA_LLM_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
NVIDIA_EMBED_MODEL="nvidia/nemotron-3.5-embed-1b"

# Resume source (PDF, or TXT/MD) and where the FAISS index is stored
# RESUME_PATH="data/resume.pdf"
# FAISS_INDEX_DIR="faiss_index"

# Number of resume chunks retrieved per question
# RAG_TOP_K=4

# Comma-separated origins allowed to call the API directly (the Vite dev server proxies /api, so this is only needed when they differ)
# ALLOWED_ORIGINS="http://localhost:3000"
